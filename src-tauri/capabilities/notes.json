{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "notes",
  "description": "Detached notes window: the note commands, listening to events, messages to the main window through the backend only, copying text, keeping itself on top (its own command only), focusing and closing it (close, then destroy once pending input is saved)",
  "windows": ["notes"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "clipboard-manager:allow-write-text",
    "allow-list-note-folders",
    "allow-list-notes",
    "allow-read-note",
    "allow-write-note",
    "allow-create-note",
    "allow-rename-note",
    "allow-delete-note",
    "allow-reorder-notes",
    "allow-reveal-notes-folder",
    "allow-search-notes",
    "allow-list-trash",
    "allow-restore-note",
    "allow-export-note",
    "allow-reveal-note",
    "allow-notes-to-main",
    "allow-set-notes-on-top"
  ]
}
