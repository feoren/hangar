{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: session commands, reloading profiles and opening the profile file, taskbar flash and badge, program updates as sessions, workspace and scrollback, notes, folder dialog, clipboard text, opening the detached notes window (fixed label, URL and size), desktop notifications, git branches and changes, worktrees, local claims (overlaps between the user's own sessions), the agent gate (answering an agent's held edit), profile editing and keychain secrets, session export, notification area icon and showing the window, read-only sub-agent view, the Hangar account (sign-in, projects, opening its own pages), the team connection (sharing a project, confirming new devices), updates and restart",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-overlay-icon",
    "core:window:allow-set-badge-count",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "allow-list-profiles",
    "allow-default-cwd",
    "allow-list-sessions",
    "allow-create-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-ack-session",
    "allow-kill-session",
    "allow-restart-session",
    "allow-rename-session",
    "allow-close-session",
    "allow-detect-versions",
    "allow-program-icons",
    "allow-profile-path",
    "allow-reload-profiles",
    "allow-open-profile-file",
    "allow-save-workspace",
    "allow-load-workspace",
    "allow-save-scrollback",
    "allow-load-scrollback",
    "allow-delete-scrollback",
    "allow-clear-scrollbacks",
    "allow-list-note-folders",
    "allow-list-notes",
    "allow-read-note",
